# Copy this file to .env.local and fill in your values

# Supabase Development Project
NUXT_PUBLIC_SUPABASE_URL=https://your-dev-project.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-dev-anon-key
NUXT_SUPABASE_SECRET_KEY=your-dev-service-role-key

# Supabase Auth — email magic link (configure SMTP in Supabase Dashboard > Auth > Email)
# Recommended: use Resend as SMTP provider

# Upstash Redis (optional for Phase 1)
UPSTASH_REDIS_REST_URL=https://your-redis-url
UPSTASH_REDIS_REST_TOKEN=your-redis-token

# Local Testing (for pnpm migrate:dev)
SUPABASE_URL_DEV=$NUXT_PUBLIC_SUPABASE_URL
SUPABASE_SECRET_KEY_DEV=$NUXT_SUPABASE_SECRET_KEY

# Resend API key
RESEND_API_KEY=abcd-1234
